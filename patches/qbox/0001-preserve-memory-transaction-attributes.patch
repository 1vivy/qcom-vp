diff --git a/qemu-components/common/include/tlm-extensions/mem-tx-attrs.h b/qemu-components/common/include/tlm-extensions/mem-tx-attrs.h
new file mode 100644
--- /dev/null
+++ b/qemu-components/common/include/tlm-extensions/mem-tx-attrs.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <tlm>
+#include <libqemu-cxx/libqemu-cxx.h>
+
+struct QemuMemTxAttrsExtension : tlm::tlm_extension<QemuMemTxAttrsExtension> {
+    qemu::MemoryRegionOps::MemTxAttrs attrs;
+    tlm::tlm_extension_base* clone() const override { return new QemuMemTxAttrsExtension(*this); }
+    void copy_from(const tlm::tlm_extension_base& other) override {
+        attrs = static_cast<const QemuMemTxAttrsExtension&>(other).attrs;
+    }
+};
