+++ b/qemu-components/common/src/libqemu-cxx/memory.cc
@@ -122,6 +122,48 @@
     m_int->exports().mr_ops_set_write_cb(m_ops, generic_write_cb);
 }
 
+static ::MemTxResult generic_bulk_read_cb(void* opaque, hwaddr addr, void* buf, hwaddr len,
+                                          MemTxAttrs qemu_attrs)
+{
+    MemoryRegionOps* ops = reinterpret_cast<MemoryRegionOps*>(opaque);
+    MemoryRegionOps::MemTxAttrs attrs(qemu_attrs);
+    MemoryRegionOps::BulkReadCallback cb = ops->get_bulk_read_callback();
+
+    if (!cb || len > std::numeric_limits<unsigned int>::max()) {
+        return MEMTX_ACCESS_ERROR;
+    }
+
+    return LIB_TO_QEMU_MEMTXRESULT_MAPPING(cb(addr, buf, len, attrs));
+}
+
+static ::MemTxResult generic_bulk_write_cb(void* opaque, hwaddr addr, const void* buf, hwaddr len,
+                                           MemTxAttrs qemu_attrs)
+{
+    MemoryRegionOps* ops = reinterpret_cast<MemoryRegionOps*>(opaque);
+    MemoryRegionOps::MemTxAttrs attrs(qemu_attrs);
+    MemoryRegionOps::BulkWriteCallback cb = ops->get_bulk_write_callback();
+
+    if (!cb || len > std::numeric_limits<unsigned int>::max()) {
+        return MEMTX_ACCESS_ERROR;
+    }
+
+    return LIB_TO_QEMU_MEMTXRESULT_MAPPING(cb(addr, buf, len, attrs));
+}
+
+void MemoryRegionOps::set_bulk_read_callback(BulkReadCallback cb)
+{
+    m_bulk_read_cb = cb;
+    m_int->exports().mr_ops_set_bulk_cb(m_ops, m_bulk_read_cb ? generic_bulk_read_cb : nullptr,
+                                        m_bulk_write_cb ? generic_bulk_write_cb : nullptr, this);
+}
+
+void MemoryRegionOps::set_bulk_write_callback(BulkWriteCallback cb)
+{
+    m_bulk_write_cb = cb;
+    m_int->exports().mr_ops_set_bulk_cb(m_ops, m_bulk_read_cb ? generic_bulk_read_cb : nullptr,
+                                        m_bulk_write_cb ? generic_bulk_write_cb : nullptr, this);
+}
+
 void MemoryRegionOps::set_max_access_size(unsigned size) { m_int->exports().mr_ops_set_max_access_size(m_ops, size); }
 
