     uint64_t m_quantum_ns; // For convenience
+
+    // Native clocks have independent epochs. Only elapsed execution time crosses domains.
+    std::mutex m_clock_epoch_mutex;
+    int64_t m_native_clock_epoch = 0;
+    sc_core::sc_time m_systemc_clock_epoch = sc_core::SC_ZERO_TIME;
+    bool m_clock_epoch_valid = false;
+
+    void rebase_native_clock()
+    {
+        std::lock_guard<std::mutex> lock(m_clock_epoch_mutex);
+        m_native_clock_epoch = m_inst.get().get_virtual_clock();
+        m_systemc_clock_epoch = m_qk->get_current_time();
+        m_clock_epoch_valid = true;
+    }
+
+    sc_core::sc_time map_native_clock(int64_t now, sc_core::sc_time sc_now)
+    {
+        std::lock_guard<std::mutex> lock(m_clock_epoch_mutex);
+        if (!m_clock_epoch_valid || now < m_native_clock_epoch) {
+            m_native_clock_epoch = now;
+            m_systemc_clock_epoch = m_qk->get_current_time();
+            m_clock_epoch_valid = true;
+        }
+        auto mapped = m_systemc_clock_epoch +
+                      sc_core::sc_time(now - m_native_clock_epoch, sc_core::SC_NS);
+        // A paused instance can resume after the other instances advance SystemC.
+        if (mapped < sc_now) {
+            m_native_clock_epoch = now;
+            m_systemc_clock_epoch = sc_now;
+            mapped = sc_now;
+        }
+        return mapped;
+    }
+
+    void invalidate_native_clock()
+    {
+        std::lock_guard<std::mutex> lock(m_clock_epoch_mutex);
+        m_clock_epoch_valid = false;
+    }
 
