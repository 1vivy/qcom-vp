+/*
+ * JESD220 RPMB frames. Big-endian fields follow the 196 stuff bytes. The
+ * HMAC-SHA256 MAC covers bytes 228..511 of every frame in one message.
+ */
+#define UFS_SECURITY_PROTOCOL_IN 0xa2
+#define UFS_SECURITY_PROTOCOL_OUT 0xb5
+#define UFS_RPMB_PROTOCOL 0xec
+#define UFS_RPMB_PROTOCOL_SPECIFIC 0x0001
+#define UFS_RPMB_MAC 196
+#define UFS_RPMB_DATA 228
+#define UFS_RPMB_NONCE 484
+#define UFS_RPMB_COUNTER 500
+#define UFS_RPMB_ADDRESS 504
+#define UFS_RPMB_BLOCKS 506
+#define UFS_RPMB_RESULT 508
+#define UFS_RPMB_TYPE 510
+
+enum {
+    UFS_RPMB_KEY_PROGRAM = 1,
+    UFS_RPMB_READ_COUNTER = 2,
+    UFS_RPMB_WRITE = 3,
+    UFS_RPMB_READ = 4,
+    UFS_RPMB_RESULT_READ = 5,
+};
+
+enum {
+    UFS_RPMB_OK = 0,
+    UFS_RPMB_GENERAL_FAILURE = 1,
+    UFS_RPMB_AUTH_FAILURE = 2,
+    UFS_RPMB_COUNTER_FAILURE = 3,
+    UFS_RPMB_ADDRESS_FAILURE = 4,
+    UFS_RPMB_WRITE_FAILURE = 5,
+    UFS_RPMB_NO_KEY = 7,
+    UFS_RPMB_COUNTER_EXPIRED = 0x80,
+};
+
+static bool ufs_rpmb_mac(const UfsRpmb *rpmb, const uint8_t *frames,
+                         uint32_t count, uint8_t *mac)
+{
+    g_autofree struct iovec *iov = g_new(struct iovec, count);
+    g_autofree uint8_t *result = NULL;
+    size_t result_len = 0;
+    QCryptoHmac *hmac;
+    int ret;
+
+    for (uint32_t i = 0; i < count; i++) {
+        iov[i].iov_base = (void *)(frames + i * UFS_RPMB_FRAME_SIZE +
+                                   UFS_RPMB_DATA);
+        iov[i].iov_len = UFS_RPMB_FRAME_SIZE - UFS_RPMB_DATA;
+    }
+    hmac = qcrypto_hmac_new(QCRYPTO_HASH_ALGO_SHA256, rpmb->key,
+                            sizeof(rpmb->key), NULL);
+    if (!hmac) {
+        return false;
+    }
+    ret = qcrypto_hmac_bytesv(hmac, iov, count, &result, &result_len, NULL);
+    qcrypto_hmac_free(hmac);
+    if (ret < 0 || result_len != 32) {
+        return false;
+    }
+    memcpy(mac, result, 32);
+    return true;
+}
+
+/* Without a programmed key the device returns a zero MAC. */
+static bool ufs_rpmb_sign(const UfsRpmb *rpmb, uint8_t *frames, uint32_t count)
+{
+    if (!rpmb->key_programmed) {
+        return true;
+    }
+    return ufs_rpmb_mac(rpmb, frames, count, frames +
+                        (count - 1) * UFS_RPMB_FRAME_SIZE + UFS_RPMB_MAC);
+}
+
+static uint8_t *ufs_rpmb_response(UfsRpmb *rpmb, uint32_t count)
+{
+    g_free(rpmb->pending);
+    rpmb->pending = g_malloc0((size_t)count * UFS_RPMB_FRAME_SIZE);
+    rpmb->pending_frames = count;
+    return rpmb->pending;
+}
+
+static void ufs_rpmb_drop_response(UfsRpmb *rpmb)
+{
+    g_free(rpmb->pending);
+    rpmb->pending = NULL;
+    rpmb->pending_frames = 0;
+}
+
+static uint16_t ufs_rpmb_counter_state(const UfsRpmb *rpmb)
+{
+    return rpmb->write_counter == UINT32_MAX ? UFS_RPMB_COUNTER_EXPIRED : 0;
+}
+
+/* Returns the result code of an authenticated write. */
+static uint16_t ufs_rpmb_write(UfsRpmb *rpmb, const uint8_t *frames,
+                               uint32_t count)
+{
+    const uint8_t *last = frames + (count - 1) * UFS_RPMB_FRAME_SIZE;
+    uint16_t address = lduw_be_p(frames + UFS_RPMB_ADDRESS);
+    uint16_t blocks = lduw_be_p(frames + UFS_RPMB_BLOCKS);
+    uint8_t mac[32];
+
+    if (!rpmb->key_programmed) {
+        return UFS_RPMB_NO_KEY;
+    }
+    if (rpmb->write_counter == UINT32_MAX) {
+        return UFS_RPMB_COUNTER_EXPIRED | UFS_RPMB_WRITE_FAILURE;
+    }
+    if (!ufs_rpmb_mac(rpmb, frames, count, mac) ||
+        memcmp(mac, last + UFS_RPMB_MAC, sizeof(mac))) {
+        return UFS_RPMB_AUTH_FAILURE;
+    }
+    if (ldl_be_p(last + UFS_RPMB_COUNTER) != rpmb->write_counter) {
+        return UFS_RPMB_COUNTER_FAILURE;
+    }
+    if (blocks != count || (uint32_t)address + blocks > rpmb->blocks) {
+        return UFS_RPMB_ADDRESS_FAILURE;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        memcpy(rpmb->data + ((size_t)address + i) * UFS_RPMB_BLOCK_SIZE,
+               frames + i * UFS_RPMB_FRAME_SIZE + UFS_RPMB_DATA,
+               UFS_RPMB_BLOCK_SIZE);
+    }
+    rpmb->write_counter++;
+    return UFS_RPMB_OK;
+}
+
+/* Applies one SECURITY PROTOCOL OUT message. False rejects the parameter list. */
+static bool ufs_rpmb_out(UfsHc *u, const uint8_t *frames, uint32_t count)
+{
+    UfsRpmb *rpmb = &u->rpmb;
+    uint16_t type = lduw_be_p(frames + UFS_RPMB_TYPE);
+    uint16_t result;
+    uint8_t *rsp;
+
+    for (uint32_t i = 1; i < count; i++) {
+        if (lduw_be_p(frames + i * UFS_RPMB_FRAME_SIZE + UFS_RPMB_TYPE) !=
+            UFS_RPMB_WRITE) {
+            return false;
+        }
+    }
+    if (count != 1 && (type != UFS_RPMB_WRITE ||
+                       count > u->geometry_desc.rpmb_read_write_size)) {
+        return false;
+    }
+
+    switch (type) {
+    case UFS_RPMB_KEY_PROGRAM:
+        ufs_rpmb_drop_response(rpmb);
+        result = UFS_RPMB_OK;
+        if (rpmb->key_programmed) {
+            result = UFS_RPMB_GENERAL_FAILURE;
+        } else {
+            memcpy(rpmb->key, frames + UFS_RPMB_MAC, sizeof(rpmb->key));
+            rpmb->key_programmed = true;
+        }
+        memset(rpmb->result, 0, sizeof(rpmb->result));
+        stw_be_p(rpmb->result + UFS_RPMB_RESULT, result);
+        stw_be_p(rpmb->result + UFS_RPMB_TYPE, UFS_RPMB_KEY_PROGRAM << 8);
+        rpmb->result_valid = true;
+        return true;
+    case UFS_RPMB_READ_COUNTER:
+        rsp = ufs_rpmb_response(rpmb, 1);
+        memcpy(rsp + UFS_RPMB_NONCE, frames + UFS_RPMB_NONCE, 16);
+        result = UFS_RPMB_NO_KEY;
+        if (rpmb->key_programmed) {
+            stl_be_p(rsp + UFS_RPMB_COUNTER, rpmb->write_counter);
+            result = UFS_RPMB_OK | ufs_rpmb_counter_state(rpmb);
+        }
+        stw_be_p(rsp + UFS_RPMB_RESULT, result);
+        stw_be_p(rsp + UFS_RPMB_TYPE, UFS_RPMB_READ_COUNTER << 8);
+        return ufs_rpmb_sign(rpmb, rsp, 1);
+    case UFS_RPMB_WRITE:
+        ufs_rpmb_drop_response(rpmb);
+        result = ufs_rpmb_write(rpmb, frames, count);
+        memset(rpmb->result, 0, sizeof(rpmb->result));
+        if (rpmb->key_programmed) {
+            stl_be_p(rpmb->result + UFS_RPMB_COUNTER, rpmb->write_counter);
+        }
+        memcpy(rpmb->result + UFS_RPMB_ADDRESS, frames + UFS_RPMB_ADDRESS, 2);
+        stw_be_p(rpmb->result + UFS_RPMB_RESULT,
+                 result | ufs_rpmb_counter_state(rpmb));
+        stw_be_p(rpmb->result + UFS_RPMB_TYPE, UFS_RPMB_WRITE << 8);
+        rpmb->result_valid = true;
+        return ufs_rpmb_sign(rpmb, rpmb->result, 1);
+    case UFS_RPMB_READ: {
+        uint16_t address = lduw_be_p(frames + UFS_RPMB_ADDRESS);
+        uint16_t blocks = lduw_be_p(frames + UFS_RPMB_BLOCKS);
+
+        if (!blocks || blocks > u->geometry_desc.rpmb_read_write_size) {
+            return false;
+        }
+        rsp = ufs_rpmb_response(rpmb, blocks);
+        result = UFS_RPMB_OK;
+        if (!rpmb->key_programmed) {
+            result = UFS_RPMB_NO_KEY;
+        } else if ((uint32_t)address + blocks > rpmb->blocks) {
+            result = UFS_RPMB_ADDRESS_FAILURE;
+        }
+        for (uint32_t i = 0; i < blocks; i++) {
+            uint8_t *frame = rsp + i * UFS_RPMB_FRAME_SIZE;
+            if (result == UFS_RPMB_OK) {
+                memcpy(frame + UFS_RPMB_DATA, rpmb->data +
+                       ((size_t)address + i) * UFS_RPMB_BLOCK_SIZE,
+                       UFS_RPMB_BLOCK_SIZE);
+            }
+            memcpy(frame + UFS_RPMB_NONCE, frames + UFS_RPMB_NONCE, 16);
+            stw_be_p(frame + UFS_RPMB_ADDRESS, address);
+            stw_be_p(frame + UFS_RPMB_BLOCKS, blocks);
+            stw_be_p(frame + UFS_RPMB_RESULT, result);
+            stw_be_p(frame + UFS_RPMB_TYPE, UFS_RPMB_READ << 8);
+        }
+        return ufs_rpmb_sign(rpmb, rsp, blocks);
+    }
+    case UFS_RPMB_RESULT_READ:
+        rsp = ufs_rpmb_response(rpmb, 1);
+        if (rpmb->result_valid) {
+            memcpy(rsp, rpmb->result, UFS_RPMB_FRAME_SIZE);
+        } else {
+            stw_be_p(rsp + UFS_RPMB_RESULT, UFS_RPMB_GENERAL_FAILURE);
+            stw_be_p(rsp + UFS_RPMB_TYPE, UFS_RPMB_RESULT_READ << 8);
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void ufs_rpmb_security_protocol(UfsLu *lu, UfsRequest *req,
+                                       uint8_t *sense_buf, uint8_t *scsi_status,
+                                       uint32_t *transferred)
+{
+    const uint8_t *cdb = req->req_upiu.sc.cdb;
+    UfsHc *u = req->hc;
+    uint32_t length = ldl_be_p(cdb + 6);
+    bool out = cdb[0] == UFS_SECURITY_PROTOCOL_OUT;
+
+    *transferred = 0;
+    *scsi_status = CHECK_CONDITION;
+    if (lu->lun != UFS_UPIU_RPMB_WLUN || !u->rpmb.blocks) {
+        scsi_build_sense(sense_buf, SENSE_CODE(INVALID_OPCODE));
+        return;
+    }
+    if (cdb[1] != UFS_RPMB_PROTOCOL ||
+        lduw_be_p(cdb + 2) != UFS_RPMB_PROTOCOL_SPECIFIC || (cdb[4] & 0x80) ||
+        !length || length % UFS_RPMB_FRAME_SIZE || length > req->data_len) {
+        scsi_build_sense(sense_buf, SENSE_CODE(INVALID_FIELD));
+        return;
+    }
+    if (out) {
+        g_autofree uint8_t *frames = g_malloc(length);
+        if (dma_buf_write(frames, length, NULL, req->sg,
+                          MEMTXATTRS_UNSPECIFIED) != MEMTX_OK ||
+            !ufs_rpmb_out(u, frames, length / UFS_RPMB_FRAME_SIZE)) {
+            scsi_build_sense(sense_buf, SENSE_CODE(INVALID_PARAM));
+            return;
+        }
+    } else {
+        if (length != u->rpmb.pending_frames * UFS_RPMB_FRAME_SIZE ||
+            dma_buf_read(u->rpmb.pending, length, NULL, req->sg,
+                         MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            scsi_build_sense(sense_buf, SENSE_CODE(INVALID_FIELD));
+            return;
+        }
+        ufs_rpmb_drop_response(&u->rpmb);
+    }
+    *transferred = length;
+    *scsi_status = GOOD;
+}
