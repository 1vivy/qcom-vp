@@ -5304 +5304,132 @@
+/*
+ * MPAM v1.0 with one PARTID and one PMG in each security space.
+ * MPAMIDR_EL1 reports zero widths and no optional virtualization controls.
+ * All requests therefore retain their existing security attributes and use
+ * PARTID=PMG=0. No memory-system partition or monitor is fabricated.
+ *
+ * Arm DDI 0601, MPAM{0,1,2,3}_ELx, MPAMIDR_EL1 and MPAMSM_EL1:
+ * https://developer.arm.com/documentation/ddi0601/2024-03/
+ */
+#define MPAM_ENABLE       (1ULL << 63)
+#define MPAM_TRAPLOWER    (1ULL << 62)
+#define MPAM_TRAP1        (1ULL << 48)
+#define MPAM_TRAP0        (1ULL << 49)
+#define MPAM_ENSM         (1ULL << 50)
+
+static CPAccessResult access_mpam(CPUARMState *env, const ARMCPRegInfo *ri,
+                                 bool isread)
+{
+    int el = arm_current_el(env);
+
+    /* MPAM1_EL12 with NVx=101 redirects before any MPAM trap check. */
+    if (el == 1 && ri->opc1 == 5 &&
+        (arm_hcr_el2_eff(env) & (HCR_NV2 | HCR_NV1 | HCR_NV)) ==
+        (HCR_NV2 | HCR_NV)) {
+        return CP_ACCESS_OK;
+    }
+    if (el < 3 && arm_feature(env, ARM_FEATURE_EL3) &&
+        (env->cp15.mpam3_el3 & MPAM_TRAPLOWER)) {
+        /* TCG does not execute instructions in external Debug state. */
+        return CP_ACCESS_TRAP_EL3;
+    }
+    if (el == 1 && arm_is_el2_enabled(env) && ri->crm == 5) {
+        if ((ri->opc1 == 0 && ri->opc2 == 0 &&
+             (env->cp15.mpam2_el2 & MPAM_TRAP1)) ||
+            (ri->opc2 == 1 && (env->cp15.mpam2_el2 & MPAM_TRAP0)) ||
+            (ri->opc2 == 3 && !(env->cp15.mpam2_el2 & MPAM_ENSM))) {
+            return CP_ACCESS_TRAP_EL2;
+        }
+    }
+    return CP_ACCESS_OK;
+}
+
+static uint64_t mpam_enable(CPUARMState *env)
+{
+    uint64_t value;
+
+    if (arm_feature(env, ARM_FEATURE_EL3)) {
+        value = env->cp15.mpam3_el3;
+    } else if (arm_feature(env, ARM_FEATURE_EL2)) {
+        value = env->cp15.mpam2_el2;
+    } else {
+        value = env->cp15.mpam1_el1;
+    }
+    return value & MPAM_ENABLE;
+}
+
+static uint64_t mpam_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    return (raw_read(env, ri) & ~MPAM_ENABLE) | mpam_enable(env);
+}
+
+static void mpam_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                       uint64_t value)
+{
+    uint64_t mask = 0;
+
+    switch (ri->opc1) {
+    case 6:
+        mask = MPAM_ENABLE | MPAM_TRAPLOWER;
+        break;
+    case 4:
+        mask = MPAM_TRAP0 | MPAM_TRAP1;
+        if (cpu_isar_feature(aa64_sme, env_archcpu(env))) {
+            mask |= MPAM_ENSM;
+        }
+        if (!arm_feature(env, ARM_FEATURE_EL3)) {
+            mask |= MPAM_ENABLE;
+        }
+        break;
+    case 0:
+        if (!arm_feature(env, ARM_FEATURE_EL3) &&
+            !arm_feature(env, ARM_FEATURE_EL2)) {
+            mask = MPAM_ENABLE;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    raw_write(env, ri, value & mask);
+}
+
+static const ARMCPRegInfo qcom_mpam_reginfo[] = {
+    { .name = "MPAM3_EL3", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 6, .crn = 10, .crm = 5, .opc2 = 0,
+      .access = PL3_RW, .resetvalue = MPAM_TRAPLOWER,
+      .fieldoffset = offsetof(CPUARMState, cp15.mpam3_el3),
+      .writefn = mpam_write, .raw_writefn = raw_write },
+    { .name = "MPAM2_EL2", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 4, .crn = 10, .crm = 5, .opc2 = 0,
+      .access = PL2_RW, .accessfn = access_mpam,
+      .type = ARM_CP_EL3_NO_EL2_KEEP,
+      .resetvalue = MPAM_TRAP0 | MPAM_TRAP1,
+      .fieldoffset = offsetof(CPUARMState, cp15.mpam2_el2),
+      .readfn = mpam_read, .raw_readfn = raw_read,
+      .writefn = mpam_write, .raw_writefn = raw_write },
+    { .name = "MPAM1_EL1", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 0, .crn = 10, .crm = 5, .opc2 = 0,
+      .access = PL1_RW, .accessfn = access_mpam,
+      .nv2_redirect_offset = 0x900 | NV2_REDIR_NV1,
+      .vhe_redir_to_el2 = ENCODE_AA64_CP_REG(3, 4, 10, 5, 0),
+      .vhe_redir_to_el01 = ENCODE_AA64_CP_REG(3, 5, 10, 5, 0),
+      .fieldoffset = offsetof(CPUARMState, cp15.mpam1_el1),
+      .readfn = mpam_read, .raw_readfn = raw_read,
+      .writefn = mpam_write, .raw_writefn = raw_write },
+    { .name = "MPAM0_EL1", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 0, .crn = 10, .crm = 5, .opc2 = 1,
+      .access = PL1_RW, .accessfn = access_mpam,
+      .type = ARM_CP_CONST, .resetvalue = 0 },
+    { .name = "MPAMIDR_EL1", .state = ARM_CP_STATE_AA64,
+      .opc0 = 3, .opc1 = 0, .crn = 10, .crm = 4, .opc2 = 4,
+      .access = PL1_R, .accessfn = access_mpam,
+      .type = ARM_CP_CONST, .resetvalue = 0 },
+};
+
+static const ARMCPRegInfo qcom_mpamsm_reginfo = {
+    .name = "MPAMSM_EL1", .state = ARM_CP_STATE_AA64,
+    .opc0 = 3, .opc1 = 0, .crn = 10, .crm = 5, .opc2 = 3,
+    .access = PL1_RW, .accessfn = access_mpam,
+    .type = ARM_CP_CONST, .resetvalue = 0,
+};
+
 static CPAccessResult access_pauth(CPUARMState *env, const ARMCPRegInfo *ri,
@@ -7551,3 +7682,9 @@
+    if (cpu->qcom_mpam) {
+        define_arm_cp_regs(cpu, qcom_mpam_reginfo);
