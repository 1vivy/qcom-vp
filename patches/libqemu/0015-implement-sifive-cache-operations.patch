diff --git a/target/riscv/op_helper.c b/target/riscv/op_helper.c
--- a/target/riscv/op_helper.c
+++ b/target/riscv/op_helper.c
@@ -544,2 +544,31 @@
+void helper_sifive_cache_operation(CPURISCVState *env, target_ulong address,
+                                   uint32_t all)
+{
+    uintptr_t ra = GETPC();
+
+    if (env->priv != PRV_M) {
+        riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, ra);
+    }
+
+    /* rs1=x0 selects all resident lines, not the line at address zero. */
+    if (all) {
+        return;
+    }
+
+    /*
+     * SiFive checks write permission at the operand address, even when PMP
+     * protects only part of a line. Do not align down or probe the whole
+     * line: either would reject a documented writable-subregion operation.
+     * The normal store MMU index preserves MPRV and locked PMP checks.
+     */
+    probe_write(env, address, 1, riscv_env_mmu_index(env, false), ra);
+
+    /*
+     * QEMU has no dirty data-cache lines. CFLUSH has nothing to write back,
+     * and CDISCARD has no private dirty data to lose. Preserve coherent RAM
+     * and do not issue stores or MMIO transactions for either operation.
+     */
+}
+
 void helper_cease(CPURISCVState *env)
 {
diff --git a/target/riscv/insn_trans/trans_privileged.c.inc b/target/riscv/insn_trans/trans_privileged.c.inc
--- a/target/riscv/insn_trans/trans_privileged.c.inc
+++ b/target/riscv/insn_trans/trans_privileged.c.inc
@@ -142,2 +142,33 @@
+static bool gen_sifive_cache_operation(DisasContext *ctx, int rs1)
+{
+#ifndef CONFIG_USER_ONLY
+    TCGv address;
+
+    if (!ctx->cfg_ptr->sifive_cache_operations) {
+        return false;
+    }
+
+    address = get_address(ctx, rs1, 0);
+    decode_save_opc(ctx, 0);
+    gen_helper_sifive_cache_operation(tcg_env, address,
+                                      tcg_constant_i32(rs1 == 0));
+    return true;
+#else
+    return false;
+#endif
+}
+
+static bool trans_cflush_d_l1(DisasContext *ctx, arg_cflush_d_l1 *a)
+{
+    /* Writeback and invalidation use the coherent-memory helper. */
+    return gen_sifive_cache_operation(ctx, a->rs1);
+}
+
+static bool trans_cdiscard_d_l1(DisasContext *ctx, arg_cdiscard_d_l1 *a)
+{
+    /* Invalidation alone has the same permission checks, without stores. */
+    return gen_sifive_cache_operation(ctx, a->rs1);
+}
