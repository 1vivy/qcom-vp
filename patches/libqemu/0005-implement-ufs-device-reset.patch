+static void ufs_device_reset_n(void *opaque, int line, int level)
+{
+    UfsHc *u = opaque;
+    bool asserted = !level;
+
+    if (asserted == u->device_reset_asserted) {
+        return;
+    }
+    if (asserted) {
+        /* The SystemC consumer rejects a busy reset before driving this input. */
+        g_assert(!u->params.mcq && !u->reg.utrldbr && !u->reg.utmrldbr);
+        for (unsigned i = 0; i < u->params.nutrs; i++) {
+            g_assert(u->req_list[i].state == UFS_REQUEST_IDLE);
+        }
+        u->reg.hcs = FIELD_DP32(u->reg.hcs, HCS, DP, 0);
+        u->reg.hcs = FIELD_DP32(u->reg.hcs, HCS, UTRLRDY, 0);
+        u->reg.hcs = FIELD_DP32(u->reg.hcs, HCS, UTMRLRDY, 0);
+        u->flags.device_init = 0;
+        for (unsigned i = 0; i < UFS_MAX_LUS; i++) {
+            if (u->lus[i] && u->lus[i]->scsi_dev) {
+                device_cold_reset(DEVICE(u->lus[i]->scsi_dev));
+            }
+        }
+    }
+    /* Release does not perform link startup or restore device presence. */
+    u->device_reset_asserted = asserted;
+}
