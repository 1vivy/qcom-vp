     sysbus_init_irq(SYS_BUS_DEVICE(dev), &u->irq);
+    qdev_init_gpio_in_named(dev, ufs_device_reset_n, "device-reset-n", 1);
 
     u->mem_as = &address_space_memory;
     u->mem_mr = get_system_memory();
