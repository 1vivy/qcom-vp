+static bool ufs_uic_dme_set_value(UfsHc *u, uint16_t attr, uint32_t value,
+                                  bool peer)
+{
+    if (peer) {
+        if (attr != 0x15a8 || !ufs_uic_peer_available(u) ||
+            !value || value > UINT16_MAX) {
+            return false;
+        }
+        u->peer_tactivate = value;
+        return true;
+    }
+    switch (attr) {
+    case 0xd002:
+        u->qcom_core_clock_control = value;
+        return true;
+    case 0x9007:
+        u->qcom_core_clock_40ns = value;
+        return true;
+    case 0x0037:
+        if (value > UINT8_MAX) {
+            return false;
+        }
+        u->pa_tx_equalizer = value;
+        return true;
+    case 0x15a8:
+        if (!value || value > UINT16_MAX) {
+            return false;
+        }
+        u->pa_tactivate = value;
+        return true;
+    case 0x15a7:
+        if (value > UINT16_MAX) {
+            return false;
+        }
+        u->pa_hibern8time = value;
+        return true;
+    case 0x15d3:
+        if (value > UINT8_MAX) {
+            return false;
+        }
+        u->pa_adapt_initial = value;
+        return true;
+    case 0x15d4:
+        if (value > 3 || value == 2) {
+            return false;
+        }
+        u->pa_adapt_type = value;
+        return true;
+    case 0x155e: case 0x155f:
+        if (value > 1) {
+            return false;
+        }
+        if (attr == 0x155e) {
+            u->pa_local_tx_lcc = value;
+        } else {
+            u->pa_peer_tx_lcc = value;
+        }
+        return true;
+    case 0x1560: /* PA_ActiveTxDataLanes */
+    case 0x1580: /* PA_ActiveRxDataLanes */
+    case UFS_ATTR_PA_AVAILTXDATALANES:
+    case UFS_ATTR_PA_AVAILRXDATALANES:
+        /* The declared topology has one lane in each direction. */
+        return value == 1;
+    case 0x15a4:
+        u->pa_save_config_time = value;
+        return true;
+    case 0x1568: case 0x1583:
+        if (value < 1 || value > 4) {
+            return false;
+        }
+        if (attr == 0x1568) {
+            u->pa_tx_gear = value;
+        } else {
+            u->pa_rx_gear = value;
+        }
+        return true;
+    case 0x1569: case 0x1584:
+        if (value > 1) {
+            return false;
+        }
+        if (attr == 0x1569) {
+            u->pa_tx_termination = value;
+        } else {
+            u->pa_rx_termination = value;
+        }
+        return true;
+    case 0x156a:
+        if (value != 1 && value != 2) {
+            return false;
+        }
+        u->pa_hs_series = value;
+        return true;
+    case 0x15b0: case 0x15b1: case 0x15b2:
+    case 0x15b3: case 0x15b4: case 0x15b5:
+        if (value > UINT16_MAX) {
+            return false;
+        }
+        u->pa_power_user_data[attr - 0x15b0] = value;
+        return true;
+    case UFS_ATTR_PA_PWRMODE: {
+        unsigned tx = value >> 4;
+        unsigned rx = value & 15;
+        if ((tx != 1 && tx != 2 && tx != 4 && tx != 5) ||
+            (rx != 1 && rx != 2 && rx != 4 && rx != 5)) {
+            return false;
+        }
+        u->pa_power_mode = value;
+        return true;
+    }
     default:
         return false;
     }
