+static UfsLu *ufs_boot_lu(UfsHc *u, uint32_t id)
+{
+    if (!u->params.boot_enable || id == 0 || id > 2) {
+        return NULL;
+    }
+    for (int i = 0; i < UFS_MAX_LUS; i++) {
+        if (u->lus[i] && u->lus[i]->boot_lun_id == id) {
+            return u->lus[i];
+        }
+    }
+    return NULL;
+}
