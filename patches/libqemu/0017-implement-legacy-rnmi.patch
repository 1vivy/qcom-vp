     if (!riscv_cpu_cfg(env)->ext_smaia && !riscv_cpu_cfg(env)->ext_smcsrind) {
@@ -2458,1 +2470,65 @@
+static RISCVException write_mnstatus(CPURISCVState *env, int csrno,
+                                     target_ulong val, uintptr_t ra);
+
+/* Per-hart dispatch: never replace the process-wide indirect CSR table. */
+static RISCVException rmw_legacy_rnmi(CPURISCVState *env, int csrno,
+                                      target_ulong *val, target_ulong new_val,
+                                      target_ulong wr_mask)
+{
+    target_ulong old, next;
+    target_ulong status_mask = MNSTATUS_MNPP | MNSTATUS_MNPV | MNSTATUS_NMIE;
+
+    switch (csrno) {
+    case CSR_MISELECT:
+        old = env->mnscratch;
+        break;
+    case CSR_MIREG:
+        old = env->mnepc & ~(target_ulong)(riscv_has_ext(env, RVC) ? 1 : 3);
+        break;
+    case CSR_MIREG2:
+        old = env->mncause;
+        break;
+    case CSR_MIREG3:
+        /* Chisel MNStatus packs MPP[12:11], MPV[7], MIE[3].
+         * These match Smrnmi, but legacy has no MNPELP field.
+         */
+        old = env->mnstatus & status_mask;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    if (val) {
+        *val = old;
+    }
+    if (!wr_mask) {
+        return RISCV_EXCP_NONE;
+    }
+    next = (old & ~wr_mask) | (new_val & wr_mask);
+    switch (csrno) {
+    case CSR_MISELECT:
+        env->mnscratch = next;
+        break;
+    case CSR_MIREG:
+        env->mnepc = next & ~(target_ulong)(riscv_has_ext(env, RVC) ? 1 : 3);
+        break;
+    case CSR_MIREG2:
+        env->mncause = next & (BIT_ULL(TARGET_LONG_BITS - 1) | 3);
+        break;
+    case CSR_MIREG3:
+        /* Rocket legalizes privilege and permits setting, not clearing MIE. */
+        if (riscv_has_ext(env, RVS)) {
+            if (get_field(next, MNSTATUS_MNPP) == PRV_RESERVED) {
+                next = set_field(next, MNSTATUS_MNPP, PRV_U);
+            }
+        } else {
+            target_ulong priv = get_field(next, MNSTATUS_MNPP);
+            next = set_field(next, MNSTATUS_MNPP,
+                             riscv_has_ext(env, RVU) && !(priv & 1) ?
+                             PRV_U : PRV_M);
+        }
+        return write_mnstatus(env, CSR_MNSTATUS, next & status_mask, 0);
+    }
+    return RISCV_EXCP_NONE;
+}
+
 static RISCVException rmw_xiselect(CPURISCVState *env, int csrno,
@@ -2464,2 +2540,6 @@
 
+    if (legacy_rnmi_csr(env, csrno)) {
